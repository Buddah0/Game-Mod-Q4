/*
===============================================================================

	Protect the President - Protection Squad

	Five support NPC builds that escort and defend the (unarmed) President.
	Each build inherits a stock Quake 4 marine def, so models, animations,
	weapons and AI behavior are reused; only the tuning below is custom.

	Common keys on every squad member:
		"leader"	"player1"	follow the President from spawn
		"follows"	"1"			click (talk) toggles follow / stop following
		"ptp_squad"	"1"			tag used by the ptp_squad console command
		"followRange" "60 128"	start following at 128 units, not the stock 192
							(ai_tactical), so they don't trail far behind

	Spawn the whole squad with the console command:  ptp_squad

===============================================================================
*/

/*
===============================================================================
	Contemporary weapons (real-world reference in README.md, "Weapons"):
		Overwatch	Barrett M82A1	.50 BMG, 10-round magazine, semi-auto
		Ram, Wrench	Mossberg 590A1	12 ga pump, 8-shell tube, 9 pellets 00 buck
		Thunder		M249 SAW		5.56 mm, 200-round belt, ~750 rpm
		Doc			AR-15 (M4A1)	5.56 mm, 30-round magazine, ~800 rpm
	"ammo" is the AI's magazine (shots before it reloads), "fireRate" is
	seconds between shots, "attack_base_count" is pellets per shot.
===============================================================================
*/

/*
===============================================================================
	Marksman attack: Barrett M82A1 (.50 BMG), slow, accurate, heavy hit with
	the stock bullet tracer on every shot
===============================================================================
*/
entityDef damage_ptp_marksman {
	"inherit"					"damage_bullet_base"
	"damage"					"90"
	"deathPush"					"150"
	"deathPushMin"				"4000 750"
	"deathPushMax"				"6750 1250"
}

entityDef hitscan_ptp_marksman {
	"inherit"					"hitscan_bullet_base"
	"def_damage"				"damage_ptp_marksman"
	"tracerchance"				"1"
}

/*
===============================================================================
	Marksman "Overwatch" - long range precision, hangs back, fragile
===============================================================================
*/
entityDef ptp_marksman {
	"inherit"						"char_marine"
	"editor_ignore"					"0"
	"editor_usage"					"Protect the President squad: Marksman (long range precision)."

	"leader"						"player1"
	"follows"						"1"
	"ptp_squad"						"1"
	"followRange"					"60 128"
	"npc_name"						"Overwatch"
	"npc_description"				"Marksman - Barrett M82A1"
	"def_head"						"char_marinehead_gen_asian"
	"skin"							"skins/models/characters/marine/viper"

	"health"						"100"
	"attackRange"					"400 2000"
	"tactical_rush"					"0"

	"ammo"							"10"
	"fireRate"						"1.2"
	"minShots"						"1"
	"maxShots"						"2"
	"actionTimer_rangedAttack_rate"	"1.5"
	"action_rangedAttack_rate"		"1.5"

	"def_attack_base"				"hitscan_ptp_marksman"
	"attack_base_hitscan"			"1"
	"attack_base_accuracy"			".25"
	"attack_base_spread"			"0"
	"def_attack_killswitch"			"hitscan_ptp_marksman"
	"attack_killswitch_hitscan"		"1"
	"attack_killswitch_accuracy"	".25"
	"attack_killswitch_spread"		"0"
}

/*
===============================================================================
	Breacher "Ram" - close quarters shotgun, the tank, regenerates health
===============================================================================
*/
entityDef ptp_breacher {
	"inherit"						"char_marine_shotgun"
	"editor_ignore"					"0"
	"editor_usage"					"Protect the President squad: Breacher (close quarters tank)."

	"leader"						"player1"
	"follows"						"1"
	"ptp_squad"						"1"
	"followRange"					"60 128"
	"npc_name"						"Ram"
	"npc_description"				"Breacher - Mossberg 590A1"
	"def_head"						"char_marinehead_helmet"
	"skin"							"skins/models/characters/marine/kodiak"

	"health"						"200"
	"healthRegenEnabled"			"1"
	"healthRegen"					"2"

	// Mossberg 590A1: 8-shell tube, 9 pellets of 00 buckshot
	"ammo"							"8"
	"attack_base_count"				"9"
	"attack_killswitch_count"		"9"
}

/*
===============================================================================
	Gunner "Thunder" - suppressing fire, long projectile bursts
===============================================================================
*/
entityDef ptp_gunner {
	"inherit"						"char_marine_hyperblaster"
	"editor_ignore"					"0"
	"editor_usage"					"Protect the President squad: Gunner (suppressing fire)."

	"leader"						"player1"
	"follows"						"1"
	"ptp_squad"						"1"
	"followRange"					"60 128"
	"npc_name"						"Thunder"
	"npc_description"				"Gunner - M249 SAW"
	"def_head"						"char_marinehead_gen_african_american_2"
	"skin"							"skins/models/characters/marine/badger"

	"health"						"150"
	"ammo"							"200"
	"minShots"						"10"
	"maxShots"						"30"
	"attack_base_accuracy"			"2"

	// M249 SAW: 5.56 mm bullets instead of plasma bolts, same gun model.
	// Stock marine round, machinegun sound and muzzle flash; 200-round belt.
	"def_attack_base"				"hitscan_marine_bullet"
	"attack_base_hitscan"			"1"
	"def_attack_killswitch"			"hitscan_marine_bullet"
	"attack_killswitch_hitscan"		"1"
	"snd_base_flash"				"npc_machinegun_fire"
	"fx_base_flash"					"effects/weapons/machinegun/muzzleflash_world.fx"
}

/*
===============================================================================
	Medic "Doc" - heals the President's health (stock rvAIMedic), machinegun
===============================================================================
*/
entityDef ptp_medic {
	"inherit"						"char_marine_medic_armed"
	"editor_ignore"					"0"
	"editor_usage"					"Protect the President squad: Medic (restores health)."

	"leader"						"player1"
	"follows"						"1"
	"ptp_squad"						"1"
	"followRange"					"60 128"
	"npc_name"						"Doc"
	"npc_description"				"Medic - AR-15 (M4A1)"

	"health"						"125"

	// AR-15 (M4A1): 30-round magazine, ~800 rpm, short bursts
	"ammo"							"30"
	"fireRate"						".075"
	"minShots"						"3"
	"maxShots"						"10"
}

/*
===============================================================================
	Engineer "Wrench" - repairs the President's armor (rvAIMedic tech), shotgun
	Same two-parent pattern as stock char_marine_tech_armed, shotgun instead of
	machinegun.
===============================================================================
*/
entityDef ptp_engineer {
	"inherit1"						"char_marine_tech_extras"
	"inherit2"						"char_marine_shotgun"
	"editor_ignore"					"0"
	"editor_usage"					"Protect the President squad: Engineer (repairs armor)."
	"def_head"						"char_marinehead_helmet_tech"

	"leader"						"player1"
	"follows"						"1"
	"ptp_squad"						"1"
	"followRange"					"60 128"
	"npc_name"						"Wrench"
	"npc_description"				"Engineer - Mossberg 590A1"

	"health"						"125"

	// Mossberg 590A1: 8-shell tube, 9 pellets of 00 buckshot
	"ammo"							"8"
	"attack_base_count"				"9"
	"attack_killswitch_count"		"9"
}
