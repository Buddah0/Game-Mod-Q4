windowDef Desktop {
	rect		0, 0, 640, 480
	backcolor	0, 0, 0, 0.7
	visible		1

	windowDef HelpPanel {
		rect		80, 60, 480, 360
		backcolor	0.1, 0.1, 0.15, 0.95
		visible		1

		windowDef HelpTitle {
			rect		20, 15, 440, 40
			forecolor	1, 0.8, 0.2, 1
			textscale	0.45
			font		"fonts/marine"
			text		"PROTECT THE PRESIDENT"
			visible		1
		}

		windowDef HelpLine {
			rect		20, 55, 440, 2
			backcolor	1, 0.8, 0.2, 0.8
			visible		1
		}

		windowDef HelpText {
			rect		20, 68, 440, 245
			forecolor	0.9, 0.9, 0.9, 1
			textscale	0.26
			font		"fonts/marine"
			text		"Hello, and welcome to Protect The President! You, the president, under the crushing weight of war stepped into the fray to complete vital objectives! But you are NOT a soldier, you have men ready to aid and defend you all the way to extraction. You will hit checkpoints to replenish your men as you advance, but try not to treat them like meat shields!\n\nCONTROLS:\n1: Attack\n2: Protect\n3: Wait\n4: Scatter"
			visible		1
		}

		windowDef DismissText {
			rect		20, 325, 440, 25
			forecolor	0.6, 0.6, 0.6, 1
			textscale	0.22
			font		"fonts/marine"
			text		"TAB - show / hide this screen"
			visible		1
		}
	}
}
